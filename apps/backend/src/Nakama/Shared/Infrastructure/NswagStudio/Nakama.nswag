{
  "runtime": "Net100",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": "{\"openapi\":\"3.0.4\",\"info\":{\"title\":\"Nakama API\",\"version\":\"1.0\"},\"paths\":{\"/api/analytics\":{\"get\":{\"tags\":[\"Analytics\"],\"summary\":\"Gets the global analytics snapshot.\",\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AnalyticsResponse\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/analytics/feedback\":{\"post\":{\"tags\":[\"Analytics\"],\"summary\":\"Records whether a chat answer was useful, towards the global useful-answer rate.\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/SubmitFeedbackRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"}}}},\"/api/auth/login\":{\"post\":{\"tags\":[\"Auth\"],\"summary\":\"Verifies email/password credentials and records real activity.\",\"description\":\"No cookie or token is issued - this only proves the credential is real and stamps LastActiveAt. Session/OAuth is a later pass.\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LoginRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/UserResponse\"}}}},\"401\":{\"description\":\"Unauthorized\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}\":{\"put\":{\"tags\":[\"Chatbots\"],\"summary\":\"Creates a new chatbot with a caller-supplied id.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/CreateChatbotRequest\"}}},\"required\":true},\"responses\":{\"201\":{\"description\":\"Created\"},\"409\":{\"description\":\"Conflict\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"get\":{\"tags\":[\"Chatbots\"],\"summary\":\"Gets the full detail page projection for one chatbot.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ChatbotDetailResponse\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/archive\":{\"post\":{\"tags\":[\"Chatbots\"],\"summary\":\"Marks a chatbot as archived.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/status\":{\"patch\":{\"tags\":[\"Chatbots\"],\"summary\":\"Updates a chatbot's status.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/UpdateChatbotStatusRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/settings\":{\"patch\":{\"tags\":[\"Chatbots\"],\"summary\":\"Replaces a chatbot's settings (Socratic mode, ExplicaMas, LLM provider).\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/UpdateChatbotSettingsRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/documents/{documentId}\":{\"put\":{\"tags\":[\"Chatbots\"],\"summary\":\"Uploads a document (PDF, Markdown, or plain text, max 20 MB) to a chatbot's knowledge base.\",\"description\":\"Newly uploaded documents are always reported as Pending - this codebase has no real indexing pipeline yet.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"documentId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"multipart/form-data\":{\"schema\":{\"required\":[\"file\",\"name\",\"origin\"],\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"string\",\"format\":\"binary\"},\"name\":{\"type\":\"string\"},\"origin\":{\"type\":\"string\"}}},\"encoding\":{\"file\":{\"style\":\"form\"},\"name\":{\"style\":\"form\"},\"origin\":{\"style\":\"form\"}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Bad Request\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/documents/{index}\":{\"delete\":{\"tags\":[\"Chatbots\"],\"summary\":\"Removes a document by its list position.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"index\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\",\"format\":\"int32\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/team\":{\"post\":{\"tags\":[\"Chatbots\"],\"summary\":\"Adds a team member to a chatbot.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AddChatbotTeamMemberRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/team/{index}\":{\"delete\":{\"tags\":[\"Chatbots\"],\"summary\":\"Removes a team member by their list position. The owner cannot be removed.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"index\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\",\"format\":\"int32\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"422\":{\"description\":\"Unprocessable Content\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{id}/icon\":{\"post\":{\"tags\":[\"Chatbots\"],\"summary\":\"Uploads or replaces a chatbot's icon image (PNG or JPEG, max 2 MB).\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"multipart/form-data\":{\"schema\":{\"required\":[\"file\"],\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"string\",\"format\":\"binary\"}}},\"encoding\":{\"file\":{\"style\":\"form\"}}}}},\"responses\":{\"204\":{\"description\":\"No Content\"},\"400\":{\"description\":\"Bad Request\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"delete\":{\"tags\":[\"Chatbots\"],\"summary\":\"Removes a chatbot's icon image.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{botKey}/conversations/{conversationId}/exchanges\":{\"post\":{\"tags\":[\"Chatbots\"],\"summary\":\"Appends a question/answer exchange to a conversation.\",\"description\":\"If no conversation exists yet with the given conversationId, one is started implicitly using that exact id - this endpoint covers both 'first message in a new chat' and 'reply within an existing conversation'.\",\"parameters\":[{\"name\":\"botKey\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"conversationId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AppendConversationExchangeRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"}}}},\"/api/chatbots/{botKey}/conversations/{conversationId}\":{\"delete\":{\"tags\":[\"Chatbots\"],\"summary\":\"Deletes a user's own conversation (hard delete). The immutable conversation audit log is untouched.\",\"parameters\":[{\"name\":\"botKey\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"conversationId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"userId\",\"in\":\"query\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots\":{\"get\":{\"tags\":[\"Chatbots\"],\"summary\":\"Lists all chatbots (summary view).\",\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/ChatbotSummaryResponse\"}}}}}}}},\"/api/chatbots/{id}/chat-page\":{\"get\":{\"tags\":[\"Chatbots\"],\"summary\":\"Gets the chat UI projection for one chatbot (opening example and chips).\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ChatPageResponse\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/chatbots/{botKey}/conversation-history\":{\"get\":{\"tags\":[\"Chatbots\"],\"summary\":\"Gets a user's conversation history for one chatbot.\",\"parameters\":[{\"name\":\"botKey\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"userId\",\"in\":\"query\",\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ConversationHistoryResponse\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}\":{\"put\":{\"tags\":[\"Formations\"],\"summary\":\"Creates a new formation with a caller-supplied id.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/CreateFormationRequest\"}}},\"required\":true},\"responses\":{\"201\":{\"description\":\"Created\"},\"409\":{\"description\":\"Conflict\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"get\":{\"tags\":[\"Formations\"],\"summary\":\"Gets the full detail page projection for one formation.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/FormationDetailResponse\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/archive\":{\"post\":{\"tags\":[\"Formations\"],\"summary\":\"Marks a formation as archived.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/status\":{\"patch\":{\"tags\":[\"Formations\"],\"summary\":\"Updates a formation's status.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/UpdateFormationStatusRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/icon\":{\"post\":{\"tags\":[\"Formations\"],\"summary\":\"Uploads or replaces a formation's icon image (PNG or JPEG, max 2 MB).\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"multipart/form-data\":{\"schema\":{\"required\":[\"file\"],\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"string\",\"format\":\"binary\"}}},\"encoding\":{\"file\":{\"style\":\"form\"}}}}},\"responses\":{\"204\":{\"description\":\"No Content\"},\"400\":{\"description\":\"Bad Request\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"delete\":{\"tags\":[\"Formations\"],\"summary\":\"Removes a formation's icon image.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/modules/{moduleId}\":{\"put\":{\"tags\":[\"Formations\"],\"summary\":\"Adds a module to a formation, using a caller-supplied module id.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"moduleId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AddFormationModuleRequest\"}}},\"required\":true},\"responses\":{\"201\":{\"description\":\"Created\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"409\":{\"description\":\"Conflict\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"patch\":{\"tags\":[\"Formations\"],\"summary\":\"Updates an existing module's fields.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"moduleId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/UpdateFormationModuleRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/modules/{moduleId}/complete\":{\"post\":{\"tags\":[\"Formations\"],\"summary\":\"Marks a module complete, with an optional score.\",\"description\":\"Enforces sequential gating: fails if the previous module is gated and hasn't been completed yet.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"moduleId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/CompleteFormationModuleRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}},\"422\":{\"description\":\"Unprocessable Content\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/modules/{moduleId}/toggle-gating\":{\"post\":{\"tags\":[\"Formations\"],\"summary\":\"Flips a module's gated flag.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"moduleId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/team\":{\"post\":{\"tags\":[\"Formations\"],\"summary\":\"Adds a team member to a formation.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AddFormationTeamMemberRequest\"}}},\"required\":true},\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations/{id}/team/{index}\":{\"delete\":{\"tags\":[\"Formations\"],\"summary\":\"Removes a team member by their list position.\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"format\":\"uuid\"}},{\"name\":\"index\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\",\"format\":\"int32\"}}],\"responses\":{\"204\":{\"description\":\"No Content\"},\"404\":{\"description\":\"Not Found\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}}},\"/api/formations\":{\"get\":{\"tags\":[\"Formations\"],\"summary\":\"Lists all formations (summary view).\",\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/FormationSummaryResponse\"}}}}}}}},\"/api/users\":{\"post\":{\"tags\":[\"Users\"],\"summary\":\"Admin-provisions a new user with an initial password.\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/CreateUserRequest\"}}},\"required\":true},\"responses\":{\"201\":{\"description\":\"Created\"},\"409\":{\"description\":\"Conflict\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/ProblemDetails\"}}}}}},\"get\":{\"tags\":[\"Users\"],\"summary\":\"Lists all users in the system (id, name, email) - e.g. to populate a team-assignment picker.\",\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/UserSummaryResponse\"}}}}}}}}},\"components\":{\"schemas\":{\"AddChatbotTeamMemberRequest\":{\"type\":\"object\",\"properties\":{\"userId\":{\"type\":\"string\",\"format\":\"uuid\"},\"role\":{\"type\":\"integer\",\"format\":\"int32\"}},\"additionalProperties\":false},\"AddFormationModuleRequest\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"nullable\":true},\"type\":{\"type\":\"integer\",\"format\":\"int32\"},\"summary\":{\"type\":\"string\",\"nullable\":true},\"gated\":{\"type\":\"boolean\"},\"aiDraft\":{\"type\":\"boolean\"},\"resourceUrl\":{\"type\":\"string\",\"nullable\":true},\"durationMin\":{\"type\":\"integer\",\"format\":\"int32\",\"nullable\":true},\"quiz\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/QuizQuestionRequest\"},\"nullable\":true},\"passingScore\":{\"type\":\"integer\",\"format\":\"int32\",\"nullable\":true}},\"additionalProperties\":false},\"AddFormationTeamMemberRequest\":{\"type\":\"object\",\"properties\":{\"userId\":{\"type\":\"string\",\"format\":\"uuid\"}},\"additionalProperties\":false},\"AnalyticsResponse\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"nullable\