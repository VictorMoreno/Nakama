{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Nakama": "Host=localhost;Port=5432;Database=nakama;Username=nakama;Password=nakama"
  },
  "Storage": {
    "ChatbotIconsPath": "App_Data/chatbot-icons",
    "ChatbotIconsRoute": "/api/chatbots/icons",
    "FormationIconsPath": "App_Data/formation-icons",
    "FormationIconsRoute": "/api/formations/icons",
    "ChatbotDocumentsPath": "App_Data/chatbot-documents",
    "ConversationAttachmentsPath": "App_Data/conversation-attachments"
  },
  "Jwt": {
    "Issuer": "nakama-api",
    "Audience": "nakama-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1
  },
  "Llm": {
    "MaxTokens": 16000
  },
  "Chat": {
    "MaxAttachmentsPerMessage": 5,
    "MaxAttachmentSizeMb": 20,
    "AllowedAttachmentExtensions": [ ".pdf", ".md", ".markdown", ".txt" ]
  },
  "Documents": {
    "MaxSizeMb": 20,
    "AllowedExtensions": [ ".pdf", ".md", ".markdown", ".txt" ]
  },
  "Reporting": {
    "TimeZone": "Europe/Madrid",
    "UserActivity": {
      "DefaultDays": 30,
      "MaxDays": 90,
      "SessionIntervalMinutes": 60
    },
    "QuestionActivity": {
      "DefaultWeeks": 8,
      "MaxWeeks": 26
    },
    "AnswerFeedback": {
      "UnhelpfulQuestionsLimit": 10
    }
  },
  "Pagination": {
    "DefaultPageSize": 12,
    "MaxPageSize": 50
  },
  "Icons": {
    "MaxSizeMb": 2,
    "ContentTypeExtensions": {
      "image/png": ".png",
      "image/jpeg": ".jpg",
      "image/jpg": ".jpg"
    }
  }
}
