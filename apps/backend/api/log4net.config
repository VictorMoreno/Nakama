<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <appender name="Console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss.fff} %-5level [%logger{1}] %message%newline%exception" />
    </layout>
  </appender>

  <appender name="File" type="log4net.Appender.RollingFileAppender">
    <file value="../external_resources/application.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value=".yyyy-MM-dd" />
    <maxSizeRollBackups value="14" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} %-5level [%logger] %message%newline%exception" />
    </layout>
  </appender>

  <logger name="Microsoft">
    <level value="WARN" />
  </logger>
  <logger name="System">
    <level value="WARN" />
  </logger>
  <logger name="NHibernate">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft.AspNetCore.Hosting.Diagnostics">
    <level value="INFO" />
  </logger>
  <logger name="Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware">
    <level value="OFF" />
  </logger>

  <root>
    <level value="INFO" />
    <appender-ref ref="Console" />
    <appender-ref ref="File" />
  </root>
</log4net>
